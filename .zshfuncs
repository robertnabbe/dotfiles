# convert mov to mp4 using ffmpeg
movtomp4 () {
  input_filename="$1"

  if [[ "$input_filename" != *.mov ]]; then
    echo "error: input file must end with .mov"
    return 1
  fi

  base_name="${input_filename%.*}"
  ffmpeg -i "$input_filename" -vcodec h264 -acodec aac "${base_name}.mp4"
}

# set iterm profile
iterm-profile() {
  echo -e "\\033]50;SetProfile=$1\\a"
  ITERM_PROFILE=$1
}

# set kitty theme
theme() {
  case "$PWD" in
    "$HOME"/Code/chiroup)
      theme='Dracula.conf'
      ;;
    "$HOME"/Code/bugs)
      theme='Nightfox.conf'
      ;;
    "$HOME"/Code/*)
      theme='1984 Dark.conf'
      ;;
    *)
      return
      ;;
  esac

  kitten @ set-colors \
    --match id:$KITTY_WINDOW_ID \
    "$HOME/.config/kitty/themes/$theme" >/dev/null 2>&1
}


